{
  "datasets": [
    {
      "name": "coffee_revenue_analysis",
      "displayName": "Coffee Revenue Analysis",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  CAST(transaction_id AS INT) AS transaction_id,\n  transaction_date,\n  transaction_time,\n  CAST(transaction_qty AS INT) AS transaction_qty,\n  CAST(store_id AS INT) AS store_id,\n  store_location,\n  CAST(product_id AS INT) AS product_id,\n  CAST(REPLACE(unit_price, ',', '.') AS DECIMAL(10,2)) AS unit_price,\n  product_category,\n  product_type,\n  product_detail\nFROM read_files(\n  '/Volumes/brightcoffeeshop/coffee_shop_table/brightcoffeeshop/Bright_Coffee_Shop_Sales_dataset (1).csv',\n  format => 'csv',\n  header => true,\n  sep => ';'\n)\n",
        "dimensions": [
          {
            "name": "transaction_date",
            "expr": "transaction_date",
            "displayName": "Transaction Date"
          },
          {
            "name": "store_location",
            "expr": "store_location",
            "displayName": "Store Location"
          },
          {
            "name": "product_category",
            "expr": "product_category",
            "displayName": "Product Category"
          },
          {
            "name": "product_type",
            "expr": "product_type",
            "displayName": "Product Type"
          },
          {
            "name": "product_detail",
            "expr": "product_detail",
            "displayName": "Product Detail"
          }
        ],
        "measures": [
          {
            "name": "total_quantity",
            "expr": "SUM(transaction_qty)",
            "displayName": "Total Quantity",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_revenue",
            "expr": "SUM(transaction_qty * unit_price)",
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "transaction_count",
            "expr": "COUNT(1)",
            "displayName": "Transaction Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    }
  ],
