--Step 1:
-- Load the coffee shop sales dataset 
CREATE OR REPLACE TEMP VIEW coffee_shop_raw AS
SELECT *
FROM read_files(
  '/Volumes/brightcoffeeshop/coffee_shop_table/brightcoffeeshop/*.csv',
  format => 'csv',
  header => true,
  delimiter => ';'
);

--Step 2:
--Check that the dataset loaded correctly 
SELECT*
FROM coffee_shop_raw
LIMIT 10;

--Step 3:
-- Create a processed version of the coffee shop sales data(cleans and converts the original columns)
CREATE OR REPLACE TEMP VIEW coffee_shop_processed AS
SELECT
    transaction_id,
    transaction_date,
    transaction_time,
    CAST(transaction_qty AS INT) AS transaction_qty,
    store_id,
    store_location,
    product_id,

    CAST(
        REPLACE(unit_price, ',', '.')
        AS DECIMAL(10,2)
    ) AS unit_price,

    product_category,
    product_type,
    product_detail,

    CAST(
        REPLACE(unit_price, ',', '.')
        AS DECIMAL(10,2)
    ) * CAST(transaction_qty AS INT) AS total_amount

FROM coffee_shop_raw;


-- Step 4: Create 30-minute time buckets

CREATE OR REPLACE TEMP VIEW coffee_shop_transformed AS

SELECT
    *,
    
    -- Extract the hour from the transaction time.
    -- This tells us which hour the transaction happened.
    hour(transaction_time) AS transaction_hour,
    
    -- Extract the minutes from the transaction time.
    -- Dividing the minutes by 30 allows us to create
    -- 30-minute intervals: 00 or 30.
    floor(minute(transaction_time) / 30) * 30 AS bucket_minute

FROM coffee_shop_processed;

-- Step 5: Create the final 30-minute time bucket

CREATE OR REPLACE TEMP VIEW coffee_shop_final AS

SELECT
    transaction_id,
    transaction_date,
    transaction_time,
    transaction_qty,
    store_id,
    store_location,
    product_id,
    unit_price,
    product_category,
    product_type,
    product_detail,
    total_amount,

    -- Combine the transaction hour and bucket minute
    -- to create a 30-minute time interval.
    -- Example: 07:06 becomes 07:00
    --          07:45 becomes 07:30
    printf(
        '%02d:%02d',
        transaction_hour,
        bucket_minute
    ) AS transformational_time_bucket

FROM coffee_shop_transformed;

-- Check whether the 30-minute time buckets were created correctly

SELECT
    transaction_time,
    transformational_time_bucket,
    unit_price,
    transaction_qty,
    total_amount
FROM coffee_shop_final
LIMIT 20;

-- TASK 2: DATA PROCESSING
-- Step 6: Group transactions by product type and 30-minute time bucket

SELECT
    product_type,
    transformational_time_bucket,

    -- Total quantity of products sold
    SUM(transaction_qty) AS total_quantity_sold,

    -- Total sales amount
    SUM(total_amount) AS total_sales,

    -- Number of transactions
    COUNT(*) AS number_of_transactions

FROM coffee_shop_final

-- Group the data so we can compare sales
-- between different product types and time periods
GROUP BY
    product_type,
    transformational_time_bucket

-- Arrange the results by product type and time
ORDER BY
    product_type,
    transformational_time_bucket;

    -- TASK 2: DATA PROCESSING
-- Step 7: Analyse sales by product category

SELECT
    product_category,

    -- Total number of products sold in each category
    SUM(transaction_qty) AS total_quantity_sold,

    -- Total sales generated by each category
    SUM(total_amount) AS total_sales,

    -- Number of transactions in each category
    COUNT(*) AS number_of_transactions,

    -- Average price of products in each category
    AVG(unit_price) AS average_unit_price

FROM coffee_shop_final

-- Group all transactions belonging to the same category
GROUP BY
    product_category

-- Show the categories with the highest sales first
ORDER BY
    total_sales DESC;

-- TASK 2: DATA PROCESSING
-- Step 8: Analyse daily sales

SELECT
    transaction_date,  -- from original table
    DAYNAME(transaction_date) AS Day_name,  -- gives the name of the day
    MONTHNAME(transaction_date) AS Month_name,  -- gives the name of the month

    -- Sales metrics
    COUNT(transaction_id) AS number_of_sales,  -- counts all transactions
    SUM(transaction_qty) AS units_sold,  -- calculates total units sold
    COUNT(DISTINCT product_id) AS unique_products,  -- counts different products
    COUNT(DISTINCT store_id) AS number_of_stores  -- counts different stores

FROM coffee_shop_final

GROUP BY transaction_date

ORDER BY transaction_date;

-- Step 9: Check for missing values

SELECT
    COUNT(*) AS total_records,

    -- Count records where unit price is missing
    SUM(CASE WHEN unit_price IS NULL THEN 1 ELSE 0 END) AS missing_unit_price,

    -- Count records where transaction quantity is missing
    SUM(CASE WHEN transaction_qty IS NULL THEN 1 ELSE 0 END) AS missing_quantity,

    -- Count records where total amount is missing
    SUM(CASE WHEN total_amount IS NULL THEN 1 ELSE 0 END) AS missing_total_amount

FROM coffee_shop_final;

--Step 10:
-- Check the total revenue for the entire dataset

SELECT
    SUM(total_amount) AS total_revenue

FROM coffee_shop_final;

--Step 11:
--Display the final processed dataset 
-- To see the processed dataset with the total amount and transformational_time_bucket columns 
SELECT *
FROM coffee_shop_final;

  
